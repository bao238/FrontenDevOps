# Server Port
PORT=5000

# GearHost / Microsoft SQL Server Connection Info
# Điền thông số từ trang quản lý GearHost hoặc SSMS của bạn
DB_SERVER=den1.mssql8.gear.host
DB_DATABASE=techstore_devops
DB_USER=techstore_admin
DB_PASSWORD=your_password_here
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Hoặc chuỗi Connection String đầy đủ (nếu dùng):
# DB_CONNECTION_STRING=Server=den1.mssql8.gear.host,1433;Database=techstore_devops;User Id=techstore_admin;Password=your_password_here;Encrypt=false;TrustServerCertificate=true;
